# CẤU HÌNH GỬI EMAIL THỰC TẾ QUA GOOGLE GMAIL SMTP CHO HỆ THỐNG SALESDSS WINMART
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Điền tài khoản Gmail dùng để gửi mã xác thực đi
SENDER_EMAIL=

# Điền Mật khẩu ứng dụng 16 ký tự của Google (Gmail App Password)
# Cách tạo trong 1 phút: Vào https://myaccount.google.com/apppasswords -> Tạo Mật khẩu ứng dụng 16 ký tự -> Dán vào đây
SENDER_APP_PASSWORD=
